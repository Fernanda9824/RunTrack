<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Titulo de la aplicacion -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RunTrack"
            android:textColor="#4CAF50"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monitoreo de movimiento"
            android:textColor="#666666"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEstadoGeneral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Estado: Detenido"
            android:textColor="#4CAF50"
            android:textStyle="bold"
            android:textSize="15sp" />

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="#DDDDDD" />

        <!-- Acelerometro -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Acelerómetro"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoAcelerometro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Comprobando disponibilidad..."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Valores del acelerometro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvAccelX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje X: 0.00 m/s²"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvAccelY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje Y: 0.00 m/s²"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvAccelZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje Z: 0.00 m/s²"
                android:textSize="16sp"
                android:textColor="#333333" />

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="#DDDDDD" />

        <!-- Giroscopio -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Giroscopio"
            android:textColor="#333333"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoGiroscopio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Comprobando disponibilidad..."
            android:textColor="#666666"
            android:textSize="13sp" />

        <!-- Valores del giroscopio -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvGyroX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje X: 0.00 rad/s"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvGyroY"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje Y: 0.00 rad/s"
                android:textSize="16sp"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/tvGyroZ"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="Eje Z: 0.00 rad/s"
                android:textSize="16sp"
                android:textColor="#333333" />

        </LinearLayout>

        <!-- Informacion del monitoreo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="15dp"
            android:background="#DDDDDD" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Información del monitoreo"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLecturasProcesadas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lecturas procesadas: 0"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvUltimaActualizacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Última actualización: --"
            android:textColor="#555555"
            android:textSize="14sp" />

        <!-- Botones de control -->
        <Button
            android:id="@+id/btnIniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Iniciar monitoreo"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDetener"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detener monitoreo"
            android:enabled="false" />

    </LinearLayout>

</ScrollView>
